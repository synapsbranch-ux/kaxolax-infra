# Proxy de l'instance applicative : CloudFront (VPC origin) → Caddy → services du compose.
{
	admin off
	auto_https off
	servers {
		# Joignable par CloudFront seulement (groupe de sécurité et en-tête secret) : son
		# X-Forwarded-For est conservé, l'API y lit l'adresse du navigateur (TRUSTED_PROXY_HOPS=2).
		trusted_proxies static 0.0.0.0/0
	}
}

:80 {
	@untrusted not header X-Kaxolax-Origin-Verify {$ORIGIN_VERIFY_SECRET}

	# route : ordre d'écriture conservé, le contrôle de l'en-tête passe avant tout le reste.
	route {
		respond @untrusted 403
		request_header -X-Kaxolax-Origin-Verify
		reverse_proxy /api/* api:3333
		reverse_proxy /realtime* realtime:1234
		reverse_proxy web:3000
	}
}
