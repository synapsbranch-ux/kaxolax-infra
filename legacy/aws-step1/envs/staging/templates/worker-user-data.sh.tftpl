#!/bin/bash
# Worker de compilation du staging (Amazon Linux 2023, arm64, sans accès à internet) : Docker,
# gVisor (runsc) et kaxolax-deploy, qui lance l'agent de compilation. Aucun secret ici.
set -euo pipefail
exec > >(tee -a /var/log/kaxolax-user-data.log) 2>&1

# retry <tentatives> <pause> <commande>...
retry() {
  local attempts=$1 delay=$2 attempt
  shift 2
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    "$@" && return 0
    echo "attempt $attempt/$attempts failed: $*"
    sleep "$delay"
  done
  return 1
}

# Dépôts dnf d'AL2023 servis par S3 (endpoint passerelle).
retry 20 15 dnf install -y docker jq bzip2
systemctl enable --now docker

# gVisor, déposé dans le bucket d'artefacts par scripts/upload-artifacts.sh (empreinte vérifiée).
gvisor=$(mktemp -d)
retry 60 30 aws s3 cp --region ${region} --recursive --quiet ${gvisor_uri} "$gvisor/"
(cd "$gvisor" && sha512sum --check gvisor.tar.bz2.sha512 && tar -xjf gvisor.tar.bz2)
install -m 0755 "$gvisor/runsc" "$gvisor/containerd-shim-runsc-v1" /usr/local/bin/
install -d /usr/local/bin/gvisor-bin
install -m 0755 "$gvisor"/gvisor-bin/* /usr/local/bin/gvisor-bin/
rm -rf "$gvisor"
/usr/local/bin/runsc install
systemctl restart docker
/usr/local/bin/runsc --version

install -d -m 0755 /etc/kaxolax
cat > /etc/kaxolax/deploy.env <<'KAXOLAX_DEPLOY_ENV'
REGION=${region}
CONFIG_URI=${config_uri}
KAXOLAX_DEPLOY_ENV

cat > /usr/local/bin/kaxolax-deploy <<'KAXOLAX_DEPLOY_SCRIPT'
${deploy_script}
KAXOLAX_DEPLOY_SCRIPT
chmod 0755 /usr/local/bin/kaxolax-deploy

# Premier déploiement : échoue tant que la CI n'a pas poussé les images dans ECR.
retry 60 30 /usr/local/bin/kaxolax-deploy ||
  echo "kaxolax-deploy failed: the deploy job of the platform CI (SSM) will run it again"
